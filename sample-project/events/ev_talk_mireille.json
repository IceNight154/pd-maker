{
  "format": "pdmaker-event",
  "version": 1,
  "id": "ev_talk_mireille",
  "kind": "common",
  "name": "미레유와 대화",
  "note": "",
  "pages": [
    {
      "cond": "",
      "trigger": "action",
      "turnEvery": 10,
      "heartCond": "",
      "graphic": {},
      "commands": [
        {
          "cmd": "text",
          "speaker": "mireille",
          "face": "",
          "illust": "",
          "text": "어, 안녕? 너도 승급시험 보러 왔구나. 난 미레유! 약초방 딸이야."
        },
        {
          "cmd": "text",
          "speaker": "mireille",
          "face": "",
          "illust": "",
          "text": "혹시 달빛 잎 봤어? 이 층 어딘가에 있을 텐데…"
        },
        {
          "cmd": "choice",
          "options": [
            "같이 찾아 줄게",
            "바빠서 안 돼"
          ],
          "branches": [
            [
              {
                "cmd": "action",
                "char": "mireille",
                "action": "TALK"
              },
              {
                "cmd": "memory",
                "char": "mireille",
                "key": "offered_help"
              },
              {
                "cmd": "text",
                "speaker": "mireille",
                "face": "smile",
                "illust": "",
                "text": "정말? 고마워!"
              }
            ],
            [
              {
                "cmd": "action",
                "char": "mireille",
                "action": "RUDE"
              },
              {
                "cmd": "text",
                "speaker": "mireille",
                "face": "worried",
                "illust": "",
                "text": "…그래. 알았어."
              }
            ]
          ]
        },
        {
          "cmd": "switch",
          "id": "met_mireille",
          "value": true
        }
      ]
    },
    {
      "cond": "switch.met_mireille",
      "trigger": "action",
      "turnEvery": 10,
      "heartCond": "",
      "graphic": {},
      "commands": [
        {
          "cmd": "topic",
          "char": "mireille",
          "topic": "greet"
        },
        {
          "cmd": "choice",
          "options": [
            "이야기한다",
            "선물을 준다",
            "그만둔다"
          ],
          "branches": [
            [
              {
                "cmd": "heartMenu",
                "char": "mireille"
              }
            ],
            [
              {
                "cmd": "if",
                "cond": "item.herb_moonleaf>=1",
                "then": [
                  {
                    "cmd": "giveItem",
                    "item": "herb_moonleaf",
                    "count": -1
                  },
                  {
                    "cmd": "action",
                    "char": "mireille",
                    "action": "GIFT_LIKED"
                  },
                  {
                    "cmd": "topic",
                    "char": "mireille",
                    "topic": "gift_liked"
                  }
                ],
                "else": [
                  {
                    "cmd": "text",
                    "speaker": "",
                    "face": "",
                    "illust": "",
                    "text": "줄 만한 것이 없다."
                  }
                ]
              }
            ],
            []
          ]
        }
      ]
    }
  ]
}
