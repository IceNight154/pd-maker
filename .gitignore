# ===== PDMaker .gitignore =====

# --- Node / Electron: npm install 로 다시 받음 (start-editor.bat 가 처음 실행 때 자동 설치) ---
node_modules/
npm-debug.log*

# --- 빌드 결과 ---
# build-exe.bat (electron-builder) 결과
editor/dist/
# make-release.bat 결과
pd-maker-release.zip
*.zip

# --- 게임 저장소(game/*)의 빌드 결과·로컬 설정 ---
build/
.gradle/
release/
# 내 PC 의 Android SDK 경로 — 올리면 안 됨
local.properties
.idea/
*.iml
*.class
*.apk
*.dex

# --- PDMaker 가 게임 저장소에 설치·생성하는 것 (runtime/ 에서 다시 설치됨) ---
game/*/core/src/main/java/com/shatteredpixel/shatteredpixeldungeon/pdmaker/
*.pdmaker-backup

# --- 임시 파일 ---
game/_*
*.tgz
*.tmp
*.pdmaker-tmp/
*.log

# --- OS ---
Thumbs.db
desktop.ini
.DS_Store

# 지울 파일 모아 두는 곳
_to_delete/

# --- 설정 · 세이브 (내 PC 에만 있어야 하는 것) ---
# PDMaker 편집기 설정 (원래 위치는 %APPDATA% — 혹시 이 폴더에 생겨도 올리지 않음)
pdmaker-settings.json
pdmaker-playtest.gradle
# 게임 세이브 · 설정 (테스트 플레이가 이 폴더 안에 저장하는 경우)
.shatteredpixel/
*.dat
settings.xml
# iOS 빌드가 만드는 설정 (게임 이름 · 패키지 이름이 들어감)
robovm.properties
# 서명 키
*.keystore
*.jks

# 업데이트 기록 (zip 으로 받은 PC 에서 어느 커밋까지 받았는지)
.pdmaker-update.json
